AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# OpenAI key, or a GitHub token (models:read) when using GitHub Models
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint, e.g. https://models.github.ai/inference
OPENAI_BASE_URL=
# gpt-4o-mini for OpenAI, openai/gpt-4o-mini for GitHub Models
OPENAI_MODEL=gpt-4o-mini
